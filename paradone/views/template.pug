doctype html
head
  meta(charset='utf-8')
  meta(http-equiv='X-UA-Compatible' content='IE=edge')
  meta(name='viewport' content='width=device-width,initial-scale=1.0')
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.2/css/all.min.css')
  link(rel='stylesheet' href='/assets/libs/bootstrap/bootstrap.min.css')
  //- Custom styles for this template
  link(rel='stylesheet', href='/assets/css/template.css')
  link(rel='icon' href='/assets/favicon.ico')
  title #{ title } | Paradone
  // Global site tag (gtag.js) - Google Analytics
  script(async='' src='https://www.googletagmanager.com/gtag/js?id=G-X2ZKVME3KP')
  script.
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-X2ZKVME3KP');
body
  .container-fluid
    .row
      .col.min-vh-100.p-4
        .col-lg-6.mx-auto.p-3.py-md-5
          .container.py-5
            header.d-flex.flex-column.flex-md-row.align-items-center.pb-3.mb-5.border-bottom
              a.d-flex.align-items-center.text-dark.text-decoration-none(href='https://paradone.com')
                span.fs-4.fw-bold paradone
              nav.d-inline-flex.mt-2.mt-md-0.ms-md-auto
                a.me-3.py-2.text-dark.text-decoration-none(href='https://blog.paradone.com') blog
                a.me-3.py-2.text-dark.text-decoration-none(href='https://app.paradone.com/register') register
                a.me-3.py-2.text-dark.text-decoration-none(href='https://app.paradone.com/login') login
            .container
              .row.template
                block content
            footer.pt-4.my-md-5.pt-md-5.border-top
              .row
                .col-12.col-md
                  h5 paradone
                  small.d-block.mb-3.text-muted &copy; 2021
                .col-6.col-md
                  h5 resources
                  ul.list-unstyled.text-small
                    li.mb-1
                      a.link-secondary.text-decoration-none(href='https://blog.paradone.com') blog
                    li.mb-1
                      a.link-secondary.text-decoration-none(href='https://app.paradone.com/register') register
                    li.mb-1
                      a.link-secondary.text-decoration-none(href='https://app.paradone.com/login') login

// built files will be auto injected
script(src='/assets/libs/bootstrap/bootstrap.bundle.min.js')
