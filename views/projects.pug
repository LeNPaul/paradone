doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    meta(name='description' content='')
    meta(name='author' content='Paul Le')
    title Dashboard | paradone
    // Bootstrap core CSS
    link(href='/assets/libs/bootstrap/bootstrap.min.css' rel='stylesheet')
    script(src='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.12.0-2/js/all.min.js')
    //- Vue.js development version, includes helpful console warnings
    script(src='https://cdn.jsdelivr.net/npm/vue/dist/vue.js')
    script(src='https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js')
    style.
      .bd-placeholder-img {
      font-size: 1.125rem;
      text-anchor: middle;
      -webkit-user-select: none;
      -moz-user-select: none;
      user-select: none;
      }
      @media (min-width: 768px) {
      .bd-placeholder-img-lg {
      font-size: 3.5rem;
      }
      }
    // Custom styles for this template
    link(href='/assets/css/sidebars.css' rel='stylesheet')
  body
    include sidebar.pug
    .col-lg-6.p-3.py-md-5#projectApp
      .p-3
        h4.pb-3.mb-3.border-bottom #{ project }
          button.btn.btn-link.link-dark(type='button' data-bs-toggle='modal' data-bs-target='#addTaskModal')
            i.fas.fa-plus
          button.btn.btn-link.link-dark.float-end(type='button' data-bs-toggle='modal' data-bs-target='#editProjectModal')
            i.fas.fa-ellipsis-v
        div(v-for='task in projectTasks' v-if='!task.completed') 
          p.pb-3.border-bottom
            button(type='submit' class='btn btn-link link-dark' v-on:click='completeTask(task.task_id)')
              i(class='far fa-circle')
            | {{ task.content }}
            button(type='button' data-bs-toggle='modal' data-bs-target='#editTaskModal' class='btn btn-link link-dark float-end' v-on:click='toggleTaskModal(task.content, task.task_id, task.project_id, task.due_datetime, task.priority, task.label_ids)')
              i.fas.fa-edit
      include modals.pug   
    script(src='/assets/libs/bootstrap/bootstrap.bundle.min.js')
    script(src='/assets/js/sidebars.js')
    script(src='/assets/js/sidebarApp.js')
    script(src='/assets/js/projectsApp.js')
