#addTaskModal.modal.fade(tabindex='-1' aria-labelledby='addTaskModalLabel' aria-hidden='true' data-bs-backdrop='static')
  .modal-dialog.modal-dialog-centered
    .modal-content
      .modal-header
        h5#addTaskModalLabel.modal-title Add Task
        button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close' v-on:click='taskText = null, selectedProject = null, dueDate = null, priority = null, projectText = null, selectedProject = null')
      .modal-body
        form(@submit.prevent)
          .mb-3
            input(type='text' class='form-control' placeholder='Add a task' v-model='taskText' style="padding-top: 16px; padding-bottom:32px; padding-left: 16px; font-size:1.25rem;")#taskText
          // input(class='form-control mb-3' placeholder="YYYY-MM-DD" v-model='dueDate')
          
          button#dropdownLabel.btn.btn-outline-dark.btn-sm.float-end(type='button' data-bs-toggle='dropdown' aria-expanded='false')
            i.fas.fa-tags
            |  {{ labels }}
          ul.dropdown-menu(aria-labelledby='dropdownLabel')
            li
              a.dropdown-item(v-on:click='setLabel("todo")') To Do
            li
              a.dropdown-item(v-on:click='setLabel("doing")') Doing
            li
              a.dropdown-item(v-on:click='setLabel("done")') Done
          
          button#dropdownPriority.btn.btn-outline-dark.btn-sm.float-end.me-2(type='button' data-bs-toggle='dropdown' aria-expanded='false')
            i.far.fa-flag 
            |  {{ priority }}
          ul.dropdown-menu(aria-labelledby='dropdownPriority')
            li
              a.dropdown-item(v-on:click='setPriority(1)') Priority 1
            li
              a.dropdown-item(v-on:click='setPriority(2)') Priority 2
            li
              a.dropdown-item(v-on:click='setPriority(3)') Priority 3
            li
              a.dropdown-item(v-on:click='setPriority(4)') Priority 4
              
          button#dropdownProject.btn.btn-outline-dark.btn-sm.float-end.me-2(type='button' data-bs-toggle='dropdown' aria-expanded='false')
            i.fas.fa-tasks 
            |  {{ projectText }}
          ul.dropdown-menu(aria-labelledby='dropdownProject')
            li(v-for='project in projects')
              a.dropdown-item(v-on:click='setProject(project.project_name, project.project_id)') {{ project.project_name }}
              
      .modal-footer
        button.btn.btn-outline-dark(type='button' data-bs-dismiss='modal' v-on:click='taskText = null, selectedProject = null, dueDate = null, priority = null, projectText = null, selectedProject = null') Close
        button.btn.btn-dark(type='button' data-bs-dismiss='modal' v-on:click='addTask()' aria-label='Close') Save
        
