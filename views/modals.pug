#addTaskModal.modal.fade(tabindex='-1' aria-labelledby='addTaskModalLabel' aria-hidden='true' data-bs-backdrop='static')
  .modal-dialog.modal-dialog-centered
    .modal-content
      .modal-header
        h5#addTaskModalLabel.modal-title Add Task
        button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close' v-on:click='taskText = null, selectedProject = null, dueDate = null, priority = null')
      .modal-body
        form(@submit.prevent)
          .mb-3
            input(type='text' class='form-control' placeholder='Add a task' v-model='taskText' style="padding-top: 16px; padding-bottom:32px; padding-left: 16px; font-size:1.25rem;")#taskText
          // input(class='form-control mb-3' placeholder="YYYY-MM-DD" v-model='dueDate')
          // label(class='form-label') Project
          // select.form-select(aria-label='Default select example' v-model="selectedProject")
            option(v-bind:value='project.project_id' v-for='project in projects') {{ project.project_name }}
          button#dropdownPriority.btn.btn-outline-dark.btn-sm.float-end(type='button' data-bs-toggle='dropdown' aria-expanded='false')
            i.far.fa-flag 
            |  {{ priority }}
          ul.dropdown-menu(aria-labelledby='dropdownPriority')
            li
              a.dropdown-item(v-on:click='setPriority(1)') Priority 1
            li
              a.dropdown-item(v-on:click='setPriority(2)') Priority 2
            li
              a.dropdown-item(v-on:click='setPriority(3)') Priority 3
            li
              a.dropdown-item(v-on:click='setPriority(4)') Priority 4
      .modal-footer
        button.btn.btn-outline-dark(type='button' data-bs-dismiss='modal' v-on:click='taskText = null, selectedProject = null, dueDate = null, priority = null') Close
        button.btn.btn-dark(type='button' data-bs-dismiss='modal' v-on:click='addTask()' aria-label='Close') Save
        
