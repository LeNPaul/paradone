doctype html
html(lang='en-US')
  head
    meta(name='viewport' content='width=device-width, initial-scale=1')
    meta(charset='utf-8')
    title Home | paradone
    link(rel='stylesheet' href='/assets/libs/bootstrap/bootstrap.min.css')
    script(defer='' src='/assets/libs/fontawesome/all.min.js')
    link(rel='stylesheet' href='/assets/css/main.css')
    link(rel='apple-touch-icon' sizes='152x152' href='/assets/apple-icon-152x152.png')
    link(rel='shortcut icon' href='/assets/favicon.ico')
  body
    .container.py-5
      header.d-flex.flex-column.flex-md-row.align-items-center.pb-3.mb-5.border-bottom
        a.d-flex.align-items-center.text-dark.text-decoration-none(href='/')
          span.fs-4.fw-bold paradone
        nav.d-inline-flex.mt-2.mt-md-0.ms-md-auto
          a.me-3.py-2.text-dark.text-decoration-none(href='/register') register
          a.me-3.py-2.text-dark.text-decoration-none(href='/login') login

      footer.pt-4.my-md-5.pt-md-5.border-top
        .row
          .col-12.col-md
            h5 paradone
            small.d-block.mb-3.text-muted © 2021
          .col-6.col-md
            h5 Features
            ul.list-unstyled.text-small
              li.mb-1
                a.link-secondary.text-decoration-none(href='/features') How It Works
          .col-6.col-md
            h5 Resources
            ul.list-unstyled.text-small
              li.mb-1
                a.link-secondary.text-decoration-none(href='/register') Register
                li.mb-1
                  a.link-secondary.text-decoration-none(href='/login') Login
          .col-6.col-md
            h5 About
            ul.list-unstyled.text-small
              li.mb-1
                a.link-secondary.text-decoration-none(href='/about') About Us
